#!/usr/bin/env bash
# Test double for curl. It plays two servers so the test suite never touches the network:
#   * https://source.example/...   serves $STUB_SRC/urls.txt and $STUB_SRC/ips.txt
#   * https://api.example/...      a tiny fake Sky ATP Open API that remembers feed content
#     in $STUB_API (one file per feed). Entries listed (one per line) in $STUB_BAD are
#     reported as "Validation error: <entry>" the way Sky ATP does.
# Every call is appended to $STUB_API/calls.log; "-k" use is logged as "INSECURE".
args=("$@"); url="${args[-1]}"
: "${STUB_SRC:?}" "${STUB_API:?}"
has() { for a in "${args[@]}"; do [ "$a" = "$1" ] && return 0; done; return 1; }
out_file=""
for ((i=0;i<${#args[@]};i++)); do [ "${args[$i]}" = "-o" ] && out_file="${args[$((i+1))]}"; done

if [[ "$url" == https://source.example/* ]]; then
  kind=urls; [[ "$url" == */ips* ]] && kind=ips
  has -k && echo "INSECURE $kind" >> "$STUB_API/calls.log"
  [ -n "${STUB_SOURCE_DOWN:-}" ] && { has -I && printf 503 && exit 0; exit 22; }
  if has -I; then printf 200; exit 0; fi
  # Simulate the source being rewritten: the first N downloads of the IP list are empty
  if [ -n "${STUB_EMPTY_FIRST:-}" ] && [ "$kind" = ips ]; then
    n=$(cat "$STUB_API/empty_count" 2>/dev/null || echo 0)
    if [ "$n" -lt "$STUB_EMPTY_FIRST" ]; then echo $((n+1)) > "$STUB_API/empty_count"; : > "$out_file"; exit 0; fi
  fi
  cp "$STUB_SRC/$kind.txt" "$out_file"; exit 0
fi

m=GET; for ((i=0;i<${#args[@]};i++)); do [ "${args[$i]}" = "-X" ] && m="${args[$((i+1))]}"; done
name="${url##*/}"; echo "$m $name" >> "$STUB_API/calls.log"
out() { # emulate curl: -o FILE drops the body; -w '%{http_code}' prints the code (after the body, or alone with -o)
  if [ -n "$out_file" ]; then
    has -w && printf '%s' "$2"
  elif has -w; then printf '%s\n%s' "$1" "$2"
  else printf '%s' "$1"; fi
}
case "$m" in
  POST) f=""; for a in "${args[@]}"; do [[ "$a" == file=@* ]] && f="${a#file=@}"; done
        if [ -f "$STUB_API/feed_$name" ]; then out '{"code":409,"message":"feed exists"}' 409
        else cp "$f" "$STUB_API/feed_$name"; out '{"request_id":"x"}' 202; fi ;;
  GET)  if [ -f "$STUB_API/feed_$name" ]; then
          bad=""; [ -n "${STUB_BAD:-}" ] && bad=$(grep -m1 -xF -f "$STUB_BAD" "$STUB_API/feed_$name" || true)
          if [ -n "$bad" ]; then out "{\"message\":\"Feed is being retried after 1 failed attempt(s). Last Error:Validation error: $bad\"}" 200
          else out '{"message":"Feed processing complete."}' 200; fi
        else out '{"code":404,"message":"not found"}' 404; fi ;;
  DELETE) if [ -f "$STUB_API/feed_$name" ]; then rm -f "$STUB_API/feed_$name"; out '{"message":"Successfully deleted feed."}' 200
          else out '{"code":404,"message":"not found"}' 404; fi ;;
esac
